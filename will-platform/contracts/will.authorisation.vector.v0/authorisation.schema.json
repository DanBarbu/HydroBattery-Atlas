{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://will-platform.ro/contracts/will.authorisation.vector.v0/authorisation.schema.json",
  "title": "will.authorisation.vector.v0 — WILL → Vector/Scorpion swarm authorisation wire",
  "description": "Attritable-only. Outbound message from will-doctrine to a Quantum-derived Vector/Scorpion swarm gateway communicating an envelope-scoped authorisation. Not a fire command. See ADR-019 for doctrine and README.md in this directory for a plain-language walkthrough.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorisation_id",
    "authorisation_type",
    "issued_at",
    "envelope_id",
    "envelope_snapshot_hash",
    "tenant_id",
    "classification",
    "swarm_id",
    "ack_deadline_ms",
    "payload",
    "doctrine_service_signature"
  ],
  "properties": {
    "schema": { "const": "will.authorisation.vector.v0" },
    "authorisation_id": { "type": "string", "format": "uuid" },
    "authorisation_type": {
      "enum": ["ISSUE", "AMEND", "REVOKE"]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "envelope_id": { "type": "string", "format": "uuid" },
    "envelope_snapshot_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "tenant_id": { "type": "string", "format": "uuid" },
    "classification": {
      "enum": [
        "NESECRET",
        "SECRET_DE_SERVICIU",
        "SECRET",
        "STRICT_SECRET",
        "STRICT_SECRET_DE_IMPORTANTA_DEOSEBITA",
        "NATO_UNCLASSIFIED",
        "NATO_RESTRICTED",
        "NATO_CONFIDENTIAL",
        "NATO_SECRET"
      ]
    },
    "swarm_id": {
      "type": "string",
      "pattern": "^(vector|scorpion)/[a-z0-9][a-z0-9._-]*$",
      "description": "Effector-family scoped swarm identifier. Must be contained by the referenced envelope's effector_allowlist (cross-check outside JSON Schema)."
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^auth-[A-Za-z0-9._-]{4,128}$",
      "description": "Required on ISSUE / AMEND (used by downstream engagement.ack). Optional on REVOKE (revocation acks reference authorisation_id directly)."
    },
    "ack_deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "description": "Vendor FCS must ACK receipt within this window."
    },
    "payload": {
      "type": "object",
      "description": "Type-specific payload. Shape depends on authorisation_type; enforced by the allOf/if/then blocks below."
    },
    "doctrine_service_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_ref", "value", "signed_over"],
      "properties": {
        "algorithm": { "enum": ["Ed25519", "ECDSA-P256"] },
        "key_ref": { "type": "string" },
        "value": { "type": "string", "contentEncoding": "base64" },
        "signed_over": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "correlation_id required on ISSUE / AMEND, optional on REVOKE",
      "if": {
        "properties": {
          "authorisation_type": { "enum": ["ISSUE", "AMEND"] }
        }
      },
      "then": { "required": ["correlation_id"] }
    },
    {
      "if": { "properties": { "authorisation_type": { "const": "ISSUE" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/EngagementPayload" }
        }
      }
    },
    {
      "if": { "properties": { "authorisation_type": { "const": "AMEND" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/EngagementPayload" }
        }
      }
    },
    {
      "if": { "properties": { "authorisation_type": { "const": "REVOKE" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/RevokePayload" }
        }
      }
    }
  ],
  "$defs": {
    "EngagementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sector",
        "target_class_allowlist",
        "weapons_state",
        "magazine_cap_swarm",
        "time_window",
        "fusion_confidence_threshold"
      ],
      "properties": {
        "sector": { "$ref": "#/$defs/GeoJSONPolygonOrMulti" },
        "target_class_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^S[HU][A-Z?*][A-Z?*].*$",
            "description": "Attritable-only. Only hostile (SH*) or unknown (SU*) affiliation patterns are accepted at wire time. Friendly (SF*) and neutral (SN*) are rejected — envelope admission catches this too, but the wire also refuses as defence in depth."
          }
        },
        "weapons_state": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{1,32}$"
          },
          "additionalProperties": { "enum": ["HOLD", "TIGHT", "FREE"] }
        },
        "magazine_cap_swarm": { "type": "integer", "minimum": 0 },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_before", "not_after"],
          "properties": {
            "not_before": { "type": "string", "format": "date-time" },
            "not_after": { "type": "string", "format": "date-time" }
          }
        },
        "grace_ms": { "type": "integer", "minimum": 0 },
        "fusion_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "swarm_composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes_expected", "per_node_magazine_estimate"],
          "properties": {
            "nodes_expected": { "type": "integer", "minimum": 1 },
            "per_node_magazine_estimate": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "RevokePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abort_ack_deadline_ms", "reason_code"],
      "properties": {
        "abort_ack_deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "reason_code": {
          "enum": [
            "ENVELOPE_REVOKED",
            "ENVELOPE_EXPIRED",
            "FAMILY_HALT",
            "TENANT_ABORT"
          ]
        },
        "reason_note": { "type": "string", "maxLength": 4096 }
      }
    },
    "GeoJSONPolygonOrMulti": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": { "type": "number" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
